{{> header}}
<main id="main">
  <section class="hero section-wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-dot"></span>{{@config.custom.heroEyebrow}}</p>
      <h1>{{@config.custom.heroTitle}}</h1>
      <p class="hero-intro">{{@config.custom.heroText}}</p>
      <div class="button-row">
        <a class="button button-primary" href="{{@config.custom.primaryActionUrl}}">{{@config.custom.primaryAction}} <span aria-hidden="true">↗</span></a>
        <a class="button button-quiet" href="{{@config.custom.secondaryActionUrl}}">{{@config.custom.secondaryAction}}</a>
      </div>
      <div class="proof">
        <p>{{@config.custom.proofLabel}}</p>
        <div class="proof-logos">
          {{#each @config.custom.proofCompanies}}
            <span class="proof-logo">{{company}}</span>
          {{/each}}
        </div>
      </div>
    </div>
    <div class="hero-visual{{#if @config.custom.heroImage}} hero-visual-image{{/if}}">
      {{#if @config.custom.heroImage}}
        <img src="{{@config.custom.heroImage}}" alt="{{@config.custom.heroImageAlt}}" fetchpriority="high">
      {{else}}
        <div class="product-window" aria-label="Illustration of the product dashboard">
          <div class="window-bar"><span class="window-dots"><i></i><i></i><i></i></span><span class="window-address">studio.reveral.app / overview</span><span class="window-avatar">J</span></div>
          <div class="dashboard">
            <aside class="dash-rail"><span class="rail-logo">r</span><span class="rail-icon active">⌂</span><span class="rail-icon">▦</span><span class="rail-icon">◇</span><span class="rail-icon">◷</span><span class="rail-spacer"></span><span class="rail-icon">⚙</span></aside>
            <div class="dash-content">
              <div class="dash-greeting"><div><span class="dash-kicker">MONDAY, OCTOBER 21</span><h2>Good morning, Jordan <span>✦</span></h2><p>Here’s what’s happening across your workspace.</p></div><button type="button" class="dash-add">＋ New project</button></div>
              <div class="dash-stats"><div><span>Active projects</span><b>12 <small>↗ 2 this week</small></b></div><div><span>Team members</span><b>28 <small>↗ 4.8%</small></b></div><div><span>On track</span><b>94% <small>↗ 6.2%</small></b></div></div>
              <div class="dash-lower"><div class="dash-chart"><div class="chart-heading"><b>Project momentum</b><span>Last 30 days⌄</span></div><div class="chart-value">82.6 <small>+12.8%</small></div><svg viewBox="0 0 440 118" role="img" aria-label="Rising project momentum chart"><defs><linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#7167ef" stop-opacity=".24"/><stop offset="1" stop-color="#7167ef" stop-opacity="0"/></linearGradient></defs><path d="M0 94 C34 88 39 61 74 68 S114 81 146 55 S190 70 220 50 S267 53 292 37 S332 55 360 28 S403 33 440 8 V118 H0Z" fill="url(#chartFill)"/><path d="M0 94 C34 88 39 61 74 68 S114 81 146 55 S190 70 220 50 S267 53 292 37 S332 55 360 28 S403 33 440 8" fill="none" stroke="#7668f2" stroke-width="3" stroke-linecap="round"/></svg><div class="chart-labels"><span>Sep 22</span><span>Sep 29</span><span>Oct 06</span><span>Oct 13</span><span>Oct 20</span></div></div><div class="dash-tasks"><div class="chart-heading"><b>Up next</b><span>View all →</span></div><div class="task-row"><span class="task-check">✓</span><span><b>Design review</b><small>Product launch</small></span><time>10:30</time></div><div class="task-row"><span class="task-check">·</span><span><b>Share early access</b><small>Customer research</small></span><time>13:00</time></div><div class="task-row"><span class="task-check">·</span><span><b>Plan next sprint</b><small>Platform team</small></span><time>15:30</time></div></div></div>
            </div>
          </div>
        </div>
        <div class="hero-float float-top"><span class="float-icon">✳</span><span><b>All systems go</b><small>Everything is on track</small></span><span class="float-check">✓</span></div>
        <div class="hero-float float-bottom"><span class="avatar-stack"><i>J</i><i>M</i><i>A</i></span><span><b>Team in sync</b><small>8 people collaborating</small></span></div>
      {{/if}}
    </div>
  </section>

  <section class="summary-strip section-wrap" aria-label="Product highlights">
    {{#each @config.custom.featureHighlights}}
      <div class="summary-item" title="{{tooltip}}"><span aria-hidden="true">{{symbol}}</span><b>{{label}}</b></div>
    {{/each}}
  </section>

  <section class="feature-section section-wrap section-space" id="features">
    <div class="section-heading">
      <div><p class="eyebrow">A thoughtful toolkit</p><h2>{{@config.custom.featuresTitle}}</h2></div>
      <p>{{@config.custom.featuresIntro}}</p>
    </div>
    <div class="feature-list">
      {{#each @config.custom.featureCards}}
        <article class="feature-row">
          <div class="feature-copy">
            <p class="eyebrow">{{eyebrow}}</p>
            <h3>{{title}}</h3>
            <p>{{description}}</p>
            <a class="text-link" href="#contact">Discover what’s possible <span aria-hidden="true">↗</span></a>
          </div>
          {{#if imageUrl}}
            <div class="feature-art feature-art-image"><img src="{{imageUrl}}" alt="{{title}}" loading="lazy"></div>
          {{else}}
            <div class="feature-art" aria-hidden="true">
              <div class="feature-art-top"><span class="art-brand">{{symbol}}</span><span class="art-menu">•••</span></div>
              <div class="art-caption"><span class="art-label">YOUR WORKSPACE</span><span class="art-streak">↗ 18% this month</span></div>
              <div class="art-title">Progress, made visible.</div>
              <div class="art-bars"><i style="--bar:42%"></i><i style="--bar:68%"></i><i style="--bar:53%"></i><i style="--bar:82%"></i><i style="--bar:64%"></i><i style="--bar:94%"></i><i style="--bar:76%"></i><i style="--bar:100%"></i></div>
              <div class="art-legend"><span>Week 1</span><span>Week 2</span><span>Week 3</span><span>Week 4</span></div>
              <div class="art-notification"><span class="notify-mark">✓</span><span><b>Milestone reached</b><small>Launch plan · just now</small></span><span class="notify-plus">＋</span></div>
            </div>
          {{/if}}
        </article>
      {{/each}}
    </div>
  </section>

  {{> media-section sectionId="showcase" sectionTitle=@config.custom.mediaTitle sectionIntro=@config.custom.mediaIntro tabs=@config.custom.mediaTabs}}
  {{> media-section sectionId="team-work" sectionTitle=@config.custom.media2Title sectionIntro=@config.custom.media2Intro tabs=@config.custom.mediaTabs2}}
  {{> media-section sectionId="details" sectionTitle=@config.custom.media3Title sectionIntro=@config.custom.media3Intro tabs=@config.custom.mediaTabs3}}

  <section class="values-section section-wrap section-space">
    <div class="section-heading">
      <div><p class="eyebrow">Our point of view</p><h2>{{@config.custom.valuesTitle}}</h2></div>
      <p>Good products are shaped by the principles behind them. Here’s what guides our work.</p>
    </div>
    <div class="values-grid">
      {{#each @config.custom.productValues}}
        <article class="value-card"><span class="value-symbol" aria-hidden="true">{{symbol}}</span><h3>{{title}}</h3><p>{{description}}</p></article>
      {{/each}}
    </div>
  </section>

  {{#if posts}}
  <section class="insights-section section-wrap section-space" id="insights">
    <div class="section-heading">
      <div><p class="eyebrow">Notes from the field</p><h2>{{@config.custom.insightsTitle}}</h2></div>
      <div><p>{{@config.custom.insightsIntro}}</p><a class="text-link" href="{{@website.url}}#insights">Visit the journal <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="insights-grid">
      {{#each posts}}
        {{> post-card}}
      {{/each}}
    </div>
  </section>
  {{/if}}
</main>
{{> cta}}
{{> footer}}
