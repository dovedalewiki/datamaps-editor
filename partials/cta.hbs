<section class="site-cta site-cta-{{@config.custom.ctaStyle}}" id="contact">
  <div class="cta-inner section-wrap">
    <div><p class="eyebrow">Let’s make it happen</p><h2>{{@config.custom.ctaTitle}}</h2><p>{{@config.custom.ctaText}}</p></div>
    <div class="cta-action"><a class="button button-cta" href="{{@config.custom.ctaUrl}}">{{@config.custom.ctaButton}} <span aria-hidden="true">↗</span></a>{{#if @config.custom.ctaNotice}}<small>{{@config.custom.ctaNotice}}</small>{{/if}}</div>
  </div>
</section>
