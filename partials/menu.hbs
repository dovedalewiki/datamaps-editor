{{#unless level}}<nav class="main-nav" aria-label="Main navigation">{{/unless}}
  <ul{{#if level}} class="submenu submenu-level-{{level}}"{{else}} class="menu menu-level-1"{{/if}}>
    {{#each items}}
      <li{{menuItemClasses}}>
        {{#if link}}<a href="{{menuUrl}}"{{#if title}} title="{{title}}"{{/if}}{{#if target}} target="{{target}}"{{/if}}{{#if rel}} rel="{{rel}}"{{/if}}>{{label}}</a>{{else}}<span>{{label}}</span>{{/if}}
        {{#if items}}{{> menu}}{{/if}}
      </li>
    {{/each}}
  </ul>
{{#unless level}}</nav>{{/unless}}
