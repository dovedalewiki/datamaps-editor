{{> header}}
<main id="main" class="reading-page">
  {{#post}}
    <article class="article article--standard">
      <header class="article-header">
        {{#if mainTag}}<a class="eyebrow" href="{{mainTag.url}}">{{mainTag.name}}</a>{{/if}}
        <h1>{{title}}</h1>
        {{#if @config.post.intro}}<p class="article-intro">{{@config.post.intro}}</p>{{/if}}
        <div class="article-meta">
          {{#if @config.custom.showPostAuthor}}{{#author}}<a href="{{url}}">{{name}}</a>{{/author}}{{/if}}
          {{#if @config.custom.showPostDate}}<time>{{date createdAt "MMM D, YYYY"}}</time>{{/if}}
        </div>
      </header>
      {{#if featuredImage}}
        <figure class="article-cover{{#if @config.post.headerImageMode}} article-cover-full{{/if}}">
          <img src="{{featuredImage.url}}" alt="{{featuredImage.alt}}" fetchpriority="high">
          {{#if featuredImage.caption}}<figcaption>{{featuredImage.caption}}</figcaption>{{/if}}
        </figure>
      {{/if}}
      <div class="article-body">{{> post-body}}</div>
      {{#if tags}}<footer class="article-tags"><span>Filed under</span>{{#each tags}}<a href="{{url}}">{{name}}</a>{{/each}}</footer>{{/if}}
    </article>
  {{/post}}
  {{#if relatedPosts}}
    <section class="related section-wrap"><div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2>Related stories</h2></div></div><div class="insights-grid">{{#each relatedPosts}}{{> post-card}}{{/each}}</div></section>
  {{/if}}
</main>
{{> cta}}
{{> footer}}
